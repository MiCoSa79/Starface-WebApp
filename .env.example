# ── .env-Vorlage für docker-compose (Stack: WebApp + InfluxDB) ──
# Auf ZimaOS in das Verzeichnis kopieren, in dem die docker-compose.yml liegt
# (cp .env.example .env) und die Werte EINMALIG setzen. Datei ist per
# .gitignore geschützt und wird nie committet.
#
# Token erzeugen (einmalig):  openssl rand -hex 32

# InfluxDB-Administrator (einmalige Initialisierung beim ersten Start)
INFLUXDB_ADMIN_PASSWORD=sehr-langes-passwort-aendern

# API-Token, das die WebApp zum Schreiben (und Ausfälle lesen) nutzt
INFLUXDB_TOKEN=openssl-rand-hex-32-eintragen
